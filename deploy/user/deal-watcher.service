[Unit]
Description=deal-watcher price check (user session)
Documentation=https://github.com/arthurnobrega/deal-watcher
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@APP_DIR@

# Credentials, 0600 and owned by you. Never in git.
EnvironmentFile=%h/.config/deal-watcher/deal-watcher.env
# Without this, Python block-buffers stdout when it is not a terminal, so a
# 13-minute cycle logs nothing until it exits and `journalctl -f` shows an
# idle screen while the thing is working.
Environment=PYTHONUNBUFFERED=1

Environment=PLAYWRIGHT_BROWSERS_PATH=%h/.cache/ms-playwright

ExecStart=@APP_DIR@/.venv/bin/deal-watcher --config %h/.config/deal-watcher/config.yaml check

# A cycle grows with the watchlist: two of the three stores cost one page load
# per candidate, so nine products take ~13 minutes. This must stay comfortably
# above that, or systemd kills the run partway and the products at the end of
# the config are silently never checked.
TimeoutStartSec=3600
# A desktop has better things to do than lose a core to a price check.
Nice=15
IOSchedulingClass=idle

StandardOutput=journal
StandardError=journal
SyslogIdentifier=deal-watcher

[Install]
WantedBy=default.target
