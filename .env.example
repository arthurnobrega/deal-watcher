# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Create a bot with @BotFather on Telegram to get the token, then message your
# bot once and read your chat id from:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: Mercado Livre store adapter (official API, no scraping).
# Register a free application at https://developers.mercadolivre.com.br/
# and enable the `mercadolivre` store in config.yaml.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
